# ============================================================
# 本地开发配置模板
# 用法：复制本文件为 application-local.yml，填入真实密钥。
# 🔴 application-local.yml 已被 .gitignore 排除，绝不能提交进仓库。
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/mian?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai
    username: root
    password: root123456          # 仅本地开发默认值，上线必须换

  data:
    redis:
      host: localhost
      port: 6379

# ------------------------------------------------------------
# 三家大模型 API Key（🔴 填真实值，不要提交）
# 代码里只读环境变量或本文件，禁止硬编码进 .java
# ------------------------------------------------------------
ai:
  provider: deepseek              # deepseek / qwen / zhipu，可切换
  deepseek:
    api-key: sk-填你的密钥
    base-url: https://api.deepseek.com
  qwen:
    api-key: sk-填你的密钥
  zhipu:
    api-key: 填你的密钥

# ------------------------------------------------------------
# JWT（Phase 1 用）
# ------------------------------------------------------------
jwt:
  secret: 换成一段足够长的随机字符串
  expire-hours: 24

server:
  port: 8080
